# MongoDB Atlas 연결 문자열
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/schoolmaps?retryWrites=true&w=majority

# 나이스 교육정보 개방포털 API 키 (https://open.neis.go.kr)
NEIS_API_KEY=your_neis_api_key_here

# Vercel Cron 보안 시크릿 (아무 랜덤 문자열)
CRON_SECRET=your_random_secret_here

# 카카오맵 JavaScript API 키 (https://developers.kakao.com)
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_map_app_key_here
